#version 430
// SCIENTIFIC GPU INTEGRATOR — optional mode, enabled with `BlackHole3D --scientific`.
//
// Root geodesic.comp (legacyEulerStep) remains the DEFAULT production path and
// is untouched. This shader is the GPU twin of bh_scientific / bh_render_cpu:
//
//   * geometric units rs = 1 (the host divides camera, disk and objects by rs);
//   * each ray is integrated in its OWN orbital plane (spherical symmetry ⇒ the
//     geodesic is planar): state (r, φ, dr, dφ) with θ ≡ π/2, so the polar
//     singularities of the global spherical chart never occur;
//   * classical RK4 (4 RHS evaluations) with the corrected Christoffel term
//     r·f·φ̇² and a geometric step dλ = clamp(k·r, min, max);
//   * continuous hit tests: segment–plane for the disk (interpolated crossing),
//     segment–sphere for horizon and objects;
//   * proof-based escape: outgoing beyond the photon sphere and beyond the scene;
//   * optional relativistic disk shading (Doppler + gravitational redshift,
//     g = 1 / (u^t (1 + Ω L_axis / E)) / sqrt(f(r_cam)), intensity ∝ g⁴),
//     selected via SciParams;
//   * camera directions live in the static observer's orthonormal frame.
//
// Kerr / spin: NOT implemented. Radiative transfer: NOT implemented.
// Reference: include/black_hole/planar_geodesic.hpp, redshift.hpp, escape.hpp.

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) writeonly uniform image2D outImage;

layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;     // in rs
    float disk_r2;     // in rs
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];  // in rs (host-scaled); the host omits the black-hole marker (bh::is_black_hole_marker)
    vec4 objColor[16];
    vec4 mass[16];
};

// Scientific-mode parameters (binding 4). Mirrors bh::render::Options.
layout(std140, binding = 4) uniform SciParams {
    int   colorMode;      // 0 = legacy vec3(1,r,0.2)·r, 1 = legacy + Doppler/redshift, 2 = Page–Thorne blackbody
    int   maxSteps;       // e.g. 4000
    float stepK;          // geometric step factor (0.02)
    float stepMin;        // in rs (0.005)
    float stepMax;        // in rs (2.0)
    float sceneBound;     // escape radius bound (rs)
    float exposure;       // Reinhard exposure for colorMode 1 / 2
    float spinSign;       // +1 / −1 disk rotation about +Y
    float tempScale;      // T0 = (3GMṀ / (8πσ rs³))^{1/4} [K]: T_eff = T0 (R(x) / r_rs³)^{1/4}
    float peakTemperature;// max T_eff over the disk [K] (brightness normalisation)
    float rOverMPerRs;    // r/M for r = 1 rs (= rs_m c² / (G M); 2 for a self-consistent rs)
    float _pad5;
} sci;

const float RS = 1.0;
const float M  = 0.5;          // geometric mass, rs = 2M
const float PHOTON_SPHERE = 1.5;

struct PRay {
    vec3 e1, e2;        // orbital-plane basis
    float r, phi, dr, dphi;
    float E, L;
    float Ly;           // (pos × dir)·ŷ — conserved angular momentum about the disk axis
};

float lapse(float r) { return 1.0 - RS / r; }

vec3 pray_pos(PRay p) { return p.r * (cos(p.phi) * p.e1 + sin(p.phi) * p.e2); }

PRay pray_init(vec3 pos, vec3 dir) {
    PRay p;
    p.r = length(pos);
    p.e1 = pos / p.r;
    vec3 Lvec = cross(pos, dir);
    float L = length(Lvec);
    if (L < 1e-7 * p.r) {
        // Radial ray: any plane containing e1.
        vec3 helper = (abs(p.e1.x) < 0.9) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
        vec3 n = normalize(cross(p.e1, helper));
        p.e2 = cross(n, p.e1);
        L = 0.0;
    } else {
        vec3 n = Lvec / L;
        p.e2 = cross(n, p.e1);
    }
    p.phi = 0.0;
    // `dir` is a direction in the STATIC camera's orthonormal frame:
    // e_r̂ = sqrt(f) ∂_r ⇒ k^r = sqrt(f)·n_r ; e_φ̂ = ∂_φ / r ⇒ k^φ = n_φ / r.
    // (Using dir as a coordinate velocity would inflate the shadow ~10 % in
    // angle at the default camera radius.) Mirrors bh::make_planar_ray.
    p.dr = sqrt(max(lapse(p.r), 0.0)) * dot(dir, p.e1);
    p.dphi = dot(dir, p.e2) / p.r;
    p.L = L;
    p.Ly = Lvec.y;
    float f = lapse(p.r);
    // Corrected null seed: E = sqrt(dr² + f r² dφ²)  (dθ = 0 in the plane).
    p.E = sqrt(max(p.dr * p.dr + f * p.r * p.r * p.dphi * p.dphi, 0.0));
    return p;
}

// Equatorial RHS: d/dλ (r, φ, dr, dφ).
vec4 rhs(vec4 y, float E) {
    float r = y.x, dr = y.z, dphi = y.w;
    float f = lapse(r);
    if (f <= 0.0) return vec4(dr, dphi, 0.0, 0.0);  // inside the horizon: frozen (captured anyway)
    float dt = E / f;
    float d2r = -(RS / (2.0 * r * r)) * f * dt * dt
              + (RS / (2.0 * r * r * f)) * dr * dr
              + r * f * dphi * dphi;                 // ← corrected factor f
    float d2phi = -2.0 * dr * dphi / r;
    return vec4(dr, dphi, d2r, d2phi);
}

void rk4(inout PRay p, float h) {
    vec4 y0 = vec4(p.r, p.phi, p.dr, p.dphi);
    vec4 k1 = rhs(y0, p.E);
    vec4 k2 = rhs(y0 + 0.5 * h * k1, p.E);
    vec4 k3 = rhs(y0 + 0.5 * h * k2, p.E);
    vec4 k4 = rhs(y0 + h * k3, p.E);
    vec4 y1 = y0 + (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4);
    p.r = y1.x; p.phi = y1.y; p.dr = y1.z; p.dphi = y1.w;
}

bool segSphere(vec3 p0, vec3 p1, vec3 c, float R, out float t) {
    vec3 d = p1 - p0;
    vec3 m = p0 - c;
    float mm = dot(m, m);
    if (mm <= R * R) { t = 0.0; return true; }
    float dd = dot(d, d);
    if (dd <= 0.0) return false;
    float md = dot(m, d);
    float cc = mm - R * R;
    float disc = md * md - dd * cc;
    if (disc < 0.0) return false;
    t = (-md - sqrt(disc)) / dd;
    return t >= 0.0 && t <= 1.0;
}

// Doppler + gravitational redshift factor for a disk element at ρ (circular
// orbit about +Y) as measured by the STATIC camera at r_cam:
//   g = g_inf / sqrt(f(r_cam)),  g_inf = 1 / (u^t (1 + Ω L_y / E)).
// Mirrors bh::redshift::doppler_gravitational_factor_at.
float redshiftFactor(float rho, float E, float Ly, float rCam) {
    float camFactor = inversesqrt(max(lapse(rCam), 1e-12));
    if (rho <= PHOTON_SPHERE) return sqrt(max(lapse(rho), 0.0)) * camFactor;
    float ut = inversesqrt(1.0 - 3.0 * M / rho);
    float omega = (sci.spinSign < 0.0 ? -1.0 : 1.0) * sqrt(M / (rho * rho * rho));
    float denom = ut * (1.0 + omega * Ly / E);
    return denom > 0.0 ? camFactor / denom : 0.0;
}

float reinhard(float c) { float v = c * sci.exposure; return v / (1.0 + v); }

// ---- Page–Thorne thin disk + blackbody colour (mirrors disk_emission.hpp) ----
// R(x), x = sqrt(r/M); zero inside the ISCO (r ≤ 6M).
float pageThorneCorrection(float rOverM) {
    if (rOverM <= 6.0) return 0.0;
    float x = sqrt(rOverM);
    const float s3 = 1.7320508075688772;
    const float s6 = 2.449489742783178;
    float logArg = ((x + s3) * (s6 - s3)) / ((x - s3) * (s6 + s3));
    return (x - s6 + 0.5 * s3 * log(logArg)) / (x * (1.0 - 3.0 / (x * x)));
}

// Planckian locus (Kim et al. 2002) → linear sRGB, max component = 1.
vec3 blackbodyRGB(float T) {
    T = clamp(T, 1667.0, 25000.0);
    float t1 = 1.0 / T, t2 = t1 * t1, t3 = t2 * t1;  // powers of 1/T (no T³ overflow risk)
    float x = (T <= 4000.0) ? (-0.2661239e9 * t3 - 0.2343589e6 * t2 + 0.8776956e3 * t1 + 0.179910)
                            : (-3.0258469e9 * t3 + 2.1070379e6 * t2 + 0.2226347e3 * t1 + 0.240390);
    float x2 = x * x, x3 = x2 * x;
    float y = (T <= 2222.0) ? (-1.1063814 * x3 - 1.34811020 * x2 + 2.18555832 * x - 0.20219683)
            : (T <= 4000.0) ? (-0.9549476 * x3 - 1.37418593 * x2 + 2.09137015 * x - 0.16748867)
                            : ( 3.0817580 * x3 - 5.87338670 * x2 + 3.75112997 * x - 0.37001483);
    float X = (y > 0.0) ? x / y : 0.0;
    float Z = (y > 0.0) ? (1.0 - x - y) / y : 0.0;
    vec3 rgb = vec3( 3.2406 * X - 1.5372 - 0.4986 * Z,
                    -0.9689 * X + 1.8758 + 0.0415 * Z,
                     0.0557 * X - 0.2040 + 1.0570 * Z);
    rgb = max(rgb, vec3(0.0));
    float m = max(rgb.r, max(rgb.g, rgb.b));
    return m > 0.0 ? rgb / m : rgb;
}

void main() {
    const int WIDTH  = 200;
    const int HEIGHT = 150;
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    float u = (2.0 * (pix.x + 0.5) / float(WIDTH)  - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / float(HEIGHT)) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);  // same orientation as geodesic.comp

    PRay ray = pray_init(cam.camPos, dir);
    vec3 prev = pray_pos(ray);
    bool cameraOnPlane = abs(prev.y) < 1e-6 * ray.r;

    vec4 color = vec4(0.0);
    bool done = false;

    for (int i = 0; i < sci.maxSteps && !done; ++i) {
        float h = clamp(sci.stepK * ray.r, sci.stepMin, sci.stepMax);
        rk4(ray, h);
        vec3 cur = pray_pos(ray);

        float bestT = 2.0;
        int kind = 0;           // 0 none, 1 horizon, 2 disk, 3 object
        vec3 bestPos = cur;
        float rho = 0.0;
        int objIdx = -1;

        float th;
        if (ray.r <= RS || segSphere(prev, cur, vec3(0.0), RS, th)) {
            bestT = (ray.r <= RS) ? 1.0 : th;
            kind = 1;
        }
        if (!(cameraOnPlane && i == 0) && prev.y * cur.y <= 0.0 && prev.y != cur.y) {
            float td = prev.y / (prev.y - cur.y);
            vec3 hp = mix(prev, cur, td);
            hp.y = 0.0;
            float rr = length(hp.xz);
            if (rr >= disk_r1 && rr <= disk_r2 && td < bestT) {
                bestT = td; kind = 2; bestPos = hp; rho = rr;
            }
        }
        for (int o = 0; o < numObjects; ++o) {
            vec3 c = objPosRadius[o].xyz;
            float R = objPosRadius[o].w;
            float to;
            if (segSphere(prev, cur, c, R, to) && to < bestT) {
                bestT = to; kind = 3; bestPos = mix(prev, cur, to); objIdx = o;
            }
        }

        if (kind == 1) {
            color = vec4(0.0, 0.0, 0.0, 1.0);
            done = true;
        } else if (kind == 2) {
            float rn = rho / disk_r2;
            if (sci.colorMode == 0) {
                color = vec4(1.0, rn, 0.2, rn);                 // legacy look (blended over black)
            } else if (sci.colorMode == 2) {
                // Page–Thorne blackbody shifted by g (no emission inside the ISCO).
                float R = pageThorneCorrection(rho * sci.rOverMPerRs);
                float Temit = (R > 0.0) ? sci.tempScale * pow(R / (rho * rho * rho), 0.25) : 0.0;
                if (Temit > 0.0) {
                    float g = redshiftFactor(rho, ray.E, ray.Ly, length(cam.camPos));
                    float rel = Temit / sci.peakTemperature;
                    float brightness = 4.0 * g * g * g * g * rel * rel * rel * rel;
                    vec3 c = blackbodyRGB(g * Temit) * brightness;
                    color = vec4(reinhard(c.r), reinhard(c.g), reinhard(c.b), 1.0);
                } else {
                    color = vec4(0.0, 0.0, 0.0, 1.0);
                }
            } else {
                float g = redshiftFactor(rho, ray.E, ray.Ly, length(cam.camPos));
                float boost = g * g * g * g;
                float a = clamp(rn, 0.0, 1.0);
                float k = a * boost;
                color = vec4(reinhard(k), reinhard(clamp(rn * g, 0.0, 1.0) * k), reinhard(0.2 * k), 1.0);
            }
            done = true;
        } else if (kind == 3) {
            vec3 N = normalize(bestPos - objPosRadius[objIdx].xyz);
            vec3 V = normalize(cam.camPos - bestPos);
            float intensity = 0.1 + 0.9 * max(dot(N, V), 0.0);
            color = vec4(objColor[objIdx].rgb * intensity, objColor[objIdx].a);
            done = true;
        } else if (ray.dr > 0.0 && ray.r > PHOTON_SPHERE && ray.r > sci.sceneBound) {
            color = vec4(0.0);   // escaped: black background like the baseline
            done = true;
        }
        prev = cur;
    }

    imageStore(outImage, pix, color);
}
